---
import Base from '../layouts/Base.astro';
import { getLedger } from '../lib/load';

const rows = getLedger();
const counts = rows.reduce<Record<string, number>>((acc, row) => {
  const key = row.status || 'unmarked';
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});
const tally = Object.entries(counts)
  .map(([status, n]) => `${n} ${status}`)
  .join(', ');
---

<Base title="Timeline" description="The manuscript event ledger, in the order the file records, with each row's verification status.">
  <article class="doc wide">
    <h1 class="page-title">Timeline</h1>
    <p class="lede">
      {rows.length} events from the manuscript ledger, in file order: {tally}. The status word is the one written on that row.
    </p>
    <p class="meta">
      The rewrite chronology is a separate document:
      <a href="/research/rewrite/research/chronology">Cardinal — Master Chronological Event Ledger</a>.
    </p>
    <ol class="ledger">
      {
        rows.map((row) => (
          <li>
            <p class="when">{row.date}</p>
            <div>
              <p class="what">{row.event}</p>
              {row.location && <p class="meta">{row.location}</p>}
              {row.why && <p class="meta">{row.why}</p>}
              {row.note && <p class="meta">{row.note}</p>}
              <p class="status">{row.status}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="bill">Rows are the file <code>books/cardinal/_project/event-ledger.csv</code>.</p>
  </article>
</Base>
