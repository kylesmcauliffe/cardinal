---
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import Bill from '../../components/Bill.astro';
import { draftLinksFor, getEpisode, getEpisodes, rewriteChaptersFor } from '../../lib/load';
import { renderMarkdown } from '../../lib/render';

export function getStaticPaths() {
  return getEpisodes().map((ep) => ({ params: { n: String(ep.n) } }));
}

const n = Number(Astro.params.n);
const ep = getEpisode(n);
const scriptHtml = await renderMarkdown(ep.script);
const reviewHtml = await renderMarkdown(ep.review);
const codaHtml = ep.coda ? await renderMarkdown(ep.coda) : '';
const drafts = draftLinksFor(ep.repo);
const chapters = rewriteChaptersFor(ep.n);
const prev = n > 1 ? getEpisode(n - 1) : undefined;
const next = n < 8 ? getEpisode(n + 1) : undefined;
---

<Base title={`${ep.title}`} description={`${ep.title}, ${ep.years}. ${ep.through}`}>
  <article class="doc">
    <p class="ep-kicker">Episode {String(ep.n).padStart(2, '0')} · {ep.years}</p>
    <h1 class="page-title ep-title">{ep.title}</h1>
    <p class="lede">{ep.through}</p>

    <div id="player">
      <Player src={ep.audio} label={`Play episode ${ep.n}`} />
    </div>

    <nav class="jumps" aria-label="On this episode">
      <a href="#script">Script</a>
      <a href="#sources">Sources</a>
      <a href="#review">Review</a>
    </nav>

    <h2 class="group-label" id="script">Script</h2>
    <div class="prose" set:html={scriptHtml} />

    <h2 class="group-label" id="sources">Sources</h2>
    <div class="prose">
      <p>{ep.sources}</p>
      {ep.end && <p>End turn, from the rewrite outline: {ep.end}</p>}
      {ep.realizes && <p>Reader realizes, from the rewrite outline: {ep.realizes}</p>}
    </div>

    {
      drafts.length > 0 && (
        <div class="catalog">
          {drafts.map((d) => (
            <a href={d.href}>
              <span class="ct">{d.title}</span>
              <span class="ck">Draft</span>
            </a>
          ))}
        </div>
      )
    }
    {
      chapters.length > 0 && (
        <div class="catalog">
          {chapters.map((d) => (
            <a href={d.href}>
              <span class="ct">{d.title}</span>
              <span class="ck">Rewrite</span>
            </a>
          ))}
        </div>
      )
    }

    <h2 class="group-label" id="review">Review</h2>
    <div class="prose" set:html={reviewHtml} />

    {
      codaHtml && (
        <>
          <h2 class="group-label">Coda in the outline</h2>
          <div class="prose" set:html={codaHtml} />
        </>
      )
    }

    <nav class="pager" aria-label="Episodes">
      {prev ? <a href={`/episodes/${prev.n}`}>← {prev.title}</a> : <span></span>}
      {next ? <a href={`/episodes/${next.n}`}>{next.title} →</a> : <span></span>}
    </nav>

    <Bill
      lines={[
        `Script and review copied read-only from ${ep.branch} at ${ep.sha.slice(0, 12)}, pull request #${ep.pr}.`,
        ep.also ?? '',
        ep.audio ? `Audio file: ${ep.audio}` : 'Audio: not recorded. No URL in site/src/data/audio-manifest.json.',
      ].filter(Boolean)}
    />
  </article>
</Base>
