---
import Base from '../layouts/Base.astro';
import { getAuthor, getEpisodes } from '../lib/load';

const episodes = getEpisodes();
const author = getAuthor();
---

<Base title="Cardinal" description="Cardinal, eight parts in chronological order. One piece of land and one fortune. Book I of The McAuliffe Codex.">
  <header class="series">
    <img class="cover" src="/cover.png" alt="" width="640" height="960" />
    <div class="copy">
      <p class="kicker">Eight parts · one piece of land · one fortune</p>
      <h1>Cardinal</h1>
      <p class="sentence">Rail controlled movement. Stanford controls succession.</p>
      <p class="sheet">Book I of The McAuliffe Codex · The Stanford Corridor · {author}</p>
      <p class="lede">
        Told in the order the rewrite outline sets down. Time only moves forward. The sentence under each title is that outline’s through-line, not a new claim.
      </p>
    </div>
  </header>
  <nav class="jumps" aria-label="Also in the series">
    <a href="/timeline">Timeline</a>
    <a href="/web">Web of People</a>
    <a href="/sources">Sources</a>
    <a href="/downloads">Downloads</a>
  </nav>
  <ol class="spine">
    {
      episodes.map((ep) => (
        <li>
          <a href={`/episodes/${ep.n}`}>
            <span class="num">{String(ep.n).padStart(2, '0')}</span>
            <span class="name">{ep.title}</span>
            <span class="years">{ep.years}</span>
            <span class="line">{ep.through}</span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>
