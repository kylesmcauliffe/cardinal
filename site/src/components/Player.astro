---
interface Props {
  src: string | null;
  label: string;
}
const { src, label } = Astro.props;
const ready = typeof src === 'string' && src.length > 0;
---

<figure class="player" data-player data-ready={ready ? 'yes' : 'no'}>
  <figcaption class="where">{label}</figcaption>
  {
    ready ? (
      <audio controls preload="metadata" src={src}>
        {label}
      </audio>
    ) : (
      <p class="soon">Audio not recorded. No file is published for this episode.</p>
    )
  }
</figure>
