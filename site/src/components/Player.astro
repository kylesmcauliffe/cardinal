---
interface Props {
  src: string;
  label: string;
  ready?: boolean;
}
const { src, label, ready = false } = Astro.props;
---

<figure class="player" data-player>
  <figcaption class="where">{label}</figcaption>
  {
    ready ? (
      <audio controls preload="metadata" src={src}>
        {label}
      </audio>
    ) : (
      <p class="soon">
        Earlier narration is not this episode. No corrected recording is published at <code>{src}</code>.
      </p>
    )
  }
</figure>
