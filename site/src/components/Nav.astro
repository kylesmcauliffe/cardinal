---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { href: '/episodes', label: 'Episodes', on: path.startsWith('/episodes') },
  { href: '/timeline', label: 'Timeline', on: path === '/timeline' },
  { href: '/web', label: 'Web', on: path.startsWith('/web') },
  { href: '/sources', label: 'Sources', on: path.startsWith('/sources') },
  { href: '/downloads', label: 'Downloads', on: path.startsWith('/downloads') },
  { href: '/research', label: 'Research', on: path.startsWith('/research') },
  { href: '/people', label: 'People', on: path === '/people' },
  { href: '/places', label: 'Places', on: path.startsWith('/places') },
];
---

<header class="bar">
  <div class="bar-row">
    <a class="brand" href="/">Cardinal</a>
    <button type="button" class="theme" id="theme" aria-pressed="false">Light</button>
  </div>
  <nav aria-label="Sections">
    {
      items.map((item) => (
        <a href={item.href} aria-current={item.on ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const btn = document.getElementById('theme');
  function paint() {
    const light = document.documentElement.dataset.theme === 'light';
    btn?.setAttribute('aria-pressed', light ? 'true' : 'false');
    if (btn) btn.textContent = light ? 'Dark' : 'Light';
  }
  paint();
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    if (next === 'light') document.documentElement.dataset.theme = 'light';
    else delete document.documentElement.dataset.theme;
    try {
      localStorage.setItem('cardinal-theme', next);
    } catch {
      /* private mode */
    }
    paint();
  });
</script>
