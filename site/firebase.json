{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "predeploy": [
        "npm --prefix \"$PROJECT_DIR\" ci --omit=dev --no-audit --no-fund",
        "npm --prefix \"$PROJECT_DIR\" run build",
        "rm -rf \"$RESOURCE_DIR/static\" && mkdir -p \"$RESOURCE_DIR/static\" && cp -a \"$PROJECT_DIR/dist/.\" \"$RESOURCE_DIR/static/\""
      ]
    }
  ],
  "hosting": {
    "public": "hosting-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "gate",
          "region": "us-central1"
        }
      }
    ]
  }
}
