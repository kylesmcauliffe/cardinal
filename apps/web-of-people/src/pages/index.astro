---
import Base from '../layouts/Base.astro';
import { data } from '../lib/data';
import { href } from '../lib/html';

const c = data.ds.meta.counts;
const verified = data.events.filter((e) => e.status === 'VERIFIED').length;
---
<Base title="Web of People" current="web">
  <div class="page">
    <p class="eyebrow">Cardinal · who knew whom</p>
    <h1>A web of the people in the story</h1>
    <p class="lede">
      {c.people} real figures from the Cardinal notes, drawn as bubbles that drift. Drag one, scroll to zoom, click for a profile with a timeline and family history. Lines are stated relationships or two people named in the same recorded event. Nothing here is invented: where the notes are silent, the profile says so.
    </p>
    <div id="web-root">
      <noscript><p class="not-recorded">The interactive web needs JavaScript. The <a href={href('/people/')}>people list</a> has the same profiles without it.</p></noscript>
    </div>
    <script>
      import { mountWeb } from '../lib/graph';
      import { data } from '../lib/data';
      const root = document.getElementById('web-root');
      if (root) mountWeb(root, { data });
    </script>
    <section aria-labelledby="how">
      <h2 id="how">How to read it</h2>
      <div class="charts-grid">
        <div><h3>Bubbles</h3><p>Size shows how many other people a person is connected to in the notes. A photo means a verified public-domain or Creative Commons portrait; a dashed ring with initials means there is none.</p></div>
        <div><h3>Lines</h3><p>Heavy lines are family. Dashed lines are mentor or recruitment. Faint dotted lines mean two people appear in the same event. Place hubs group people who are recorded at the same place.</p></div>
        <div><h3>Status</h3><p>{verified} of {c.events} events are marked Verified in the project’s ledger. The rest are labelled Draft, Needs source or Contested, always as a word.</p></div>
      </div>
    </section>
  </div>
</Base>
