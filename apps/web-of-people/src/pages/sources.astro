---
import Base from '../layouts/Base.astro';
import { data } from '../lib/data';

const REPO = 'https://github.com/kylesmcauliffe/cardinal/blob/main/';
const counts = new Map<string, number>();
const bump = (f: string) => counts.set(f, (counts.get(f) ?? 0) + 1);
data.people.forEach((p) => p.roleCites?.forEach((c) => bump(c.f)));
data.events.forEach((e) => e.cites.forEach((c) => bump(c.f)));
data.relationships.forEach((r) => r.cites.forEach((c) => bump(c.f)));
const rows = data.ds.sources.map((s) => ({ s, n: counts.get(s.path) ?? 0 })).sort((a, b) => b.n - a.n);
const byStatus = ['VERIFIED', 'NEEDS SOURCE', 'CONTESTED', 'DRAFT'].map((k) => [k, data.events.filter((e) => e.status === k).length] as const);
---
<Base title="Sources" current="sources" description="The repository files behind every fact in the web, and how much weight each carries.">
  <div class="page">
    <p class="eyebrow">{rows.length} repository files</p>
    <h1>Sources</h1>
    <p class="lede">Every person, event and relationship cites one of these files with a verbatim quote, and an automated test re-reads the files to confirm the quote is there. Weight says how far to trust each kind of file.</p>
    <table class="sheet-table">
      <thead><tr><th scope="col">File</th><th scope="col">Kind</th><th scope="col">Citations</th><th scope="col">Weight</th></tr></thead>
      <tbody>
        {rows.map(({ s, n }) => (
          <tr>
            <td><a href={REPO + s.path.split('/').map(encodeURIComponent).join('/')} rel="noopener">{s.title}</a><br /><code class="dim" style="font-size:.78rem;word-break:break-all">{s.path}</code></td>
            <td>{s.kind}</td>
            <td>{n}</td>
            <td>{s.weight}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <h2>Event status</h2>
    <ul class="fam-list">
      {byStatus.map(([k, n]) => <li><span class="fam-rel">{k}</span> {n} events</li>)}
    </ul>
    <p class="dim">Verified, Needs source and Contested are the author’s own ledger labels. Draft marks facts taken from drafting notes that the research log has not verified.</p>
  </div>
</Base>
