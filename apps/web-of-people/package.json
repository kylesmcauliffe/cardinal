{
  "name": "web-of-people",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive web of people for Cardinal. Self-contained; reusable in Dawn.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run data && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "data": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check",
    "test": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "shoot": "node scripts/shoot.mjs",
    "check": "npm run data:check && npm test && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@fontsource-variable/anybody": "^5.2.8",
    "@fontsource/literata": "^5.2.8",
    "playwright-core": "^1.55.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
